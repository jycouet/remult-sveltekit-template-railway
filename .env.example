# Unset = JSON files in ./db. Set it (docker compose up -d) and remult switches to postgres.
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/app"

# Signs the session cookie. Generate one: openssl rand -base64 32
AUTH_SECRET=""

# The first account created becomes admin. This is only a later escape hatch:
# any email listed here holds every role, whatever the database says.
# SUPER_ADMIN_EMAILS="you@example.com"

# Make people click a mailed link before their first sign-in.
REQUIRE_EMAIL_VERIFICATION="false"

# Where mail goes. Unset = an ethereal.email test inbox (nothing reaches a real person).
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
